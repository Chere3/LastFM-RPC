# LastFM-RPC Environment Configuration
# Copy this file to .env and fill in your values

# Last.fm API Credentials (required)
# Get your API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_USERNAME=your-lastfm-username

# Discord Application ID (optional - uses default if not set)
# Create your own at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-application-id

# Polling Configuration (optional)
POLL_INTERVAL_MS=5000
