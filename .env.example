# LastFM-RPC Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Last.fm API Credentials (required)
# Get your API key at: https://www.last.fm/api/account/create
# =============================================================================
API_KEY=your-lastfm-api-key
API_SECRET=your-lastfm-api-secret
USER=your-lastfm-username

# =============================================================================
# Discord Application ID (required)
# Create your own at: https://discord.com/developers/applications
# =============================================================================
CLIENT_ID=your-discord-application-id

# Optional: Polling interval in milliseconds (minimum 3000)
POLL_INTERVAL_MS=6000
